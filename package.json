{
  "name": "jecoute",
  "private": true,
  "version": "0.1.0",
  "description": "J’écoute : dictée vocale locale, tu parles, il écrit là où est ton curseur. Basé sur Handy de CJ Pais.",
  "author": "Théo Ponthieu",
  "contributors": [
    "CJ Pais"
  ],
  "license": "MIT AND PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/ponthieutheo/jecoute",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponthieutheo/jecoute.git"
  },
  "bugs": "https://github.com/ponthieutheo/jecoute/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:keyboard": "bun src/lib/utils/keyboard.test.ts",
    "check:translations": "bun scripts/check-translations.ts",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.6",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "i18next": "^25.10.10",
    "immer": "^11.1.21",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-select": "^5.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "three": "0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/three": "0.186.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^6.4.4"
  }
}
