{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J’écoute",
  "mainBinaryName": "jecoute",
  "version": "0.2.1",
  "identifier": "io.github.ponthieutheo.jecoute",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "J’écoute",
    "copyright": "Copyright © 2025 CJ Pais, © 2026 Théo Ponthieu",
    "shortDescription": "Dictée vocale locale : tu parles, il écrit là où est ton curseur.",
    "longDescription": "J’écoute transcrit ta voix sur ton ordinateur, sans envoyer l'audio en ligne, et colle le texte là où est ton curseur. Basé sur Handy de CJ Pais.",
    "homepage": "https://github.com/ponthieutheo/jecoute",
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["resources/**/*"],
    "license": "MIT AND PolyForm-Noncommercial-1.0.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0", "libopenblas0"],
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "868C71D7-EE8A-408B-8F3D-0AED589C9F88"
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "languages": ["English", "French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyQkYyMzkxNjA2QzM2MApSV1Jnd3dZV09mSXJCa3QzR0ZDQ3BteWYyeDVUUG13QnVMMldXZ1luR2dGN1EzUWl0cEhEZFc1YQo=",
      "endpoints": [
        "https://github.com/ponthieutheo/jecoute/releases/latest/download/latest.json"
      ]
    }
  }
}
